{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:window:allow-minimize",
    "core:default",
    "core:window:allow-close",
    "opener:default",
    "fs:default",
    "fs:allow-app-write",
    "fs:allow-app-write-recursive",

    "fs:allow-appdata-read", 
    "fs:allow-appdata-meta"
  ]
}
